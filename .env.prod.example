DJANGO_SETTINGS_MODULE=config.django.production

SECRET_KEY=change-me
ALLOWED_HOSTS=api.fitboook.ir
CORS_ALLOWED_ORIGINS=https://your-frontend.example

# nginx terminates real TLS for api.fitboook.ir (see nginx/nginx.conf + scripts/init-letsencrypt.sh) — safe
# to leave True once that cert is issued. Leaving it True WITHOUT a working TLS-terminating proxy in front
# makes the app unreachable (it 301s every request to an https:// URL nothing serves).
SECURE_SSL_REDIRECT=True

# Docker-network service names (not localhost) since web/worker reach these over docker-compose.prod.yml's network.
DATABASE_URL=psql://course_platform:course_platform@postgres:5432/course_platform

POSTGRES_DB=course_platform
POSTGRES_USER=course_platform
POSTGRES_PASSWORD=course_platform

REDIS_URL=redis://redis:6379/0

# MinIO's admin/management API is reachable over the internet (via nginx path-routing on api.fitboook.ir,
# see docker-compose.prod.yml and nginx/nginx.conf) — anyone with these credentials can manage every bucket,
# so change them from the defaults.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=False
MINIO_VIDEO_BUCKET=encrypted-videos
MINIO_COURSE_COVER_BUCKET=course-covers

# Public host used in URLs returned to browsers/apps (presigned video URLs, cover image URLs).
# nginx routes requests for the known bucket-name path prefixes (encrypted-videos/, course-covers/,
# app-releases/) to MinIO on the SAME domain/port/cert as the API (443) — no separate port, path untouched
# so presigned SigV4 signatures still validate. MinIO's raw :9000 is not published to the host at all.
# MINIO_ENDPOINT above stays the internal docker hostname (used for actual upload/delete operations).
MINIO_PUBLIC_ENDPOINT=api.fitboook.ir
MINIO_PUBLIC_SECURE=True

# Generate with: python -c "import secrets;print(secrets.token_hex(32))"
VIDEO_MASTER_KEY=

ZARINPAL_MERCHANT_ID=

# Fixed origin used to build the ZarinPal callback_url — must match the domain registered in ZarinPal's
# merchant panel exactly.
PUBLIC_BASE_URL=https://api.fitboook.ir

# sms.ir panel -> Developers -> API keys / line number / verify template
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAMETER_NAME=CODE
